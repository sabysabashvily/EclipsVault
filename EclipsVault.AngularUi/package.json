{
  "name": "eclipsvault-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node check-runtime-deps.mjs",
    "build": "ng build && node move-index.mjs",
    "postbuild": "node check-index.mjs",
    "test": "ng test",
    "test:build-checks": "node --test build-checks.test.mjs",
    "lint": "ng lint && eslint e2e playwright.config.ts && tsc --project e2e/tsconfig.json && node --test lint-checks.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api-types": "dotnet build ../EclipsVault.UiApiDocument -c Release -p:RestoreLockedMode=true && openapi-typescript ../EclipsVault.UiApiDocument/obj/ui-api.openapi.json -o src/app/ui-api/schema.generated.ts",
    "check:api-types": "npm run generate:api-types -- --check",
    "e2e": "node e2e/run.mjs",
    "e2e:verify-guards": "node e2e/run.mjs --verify-guards"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.22.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
