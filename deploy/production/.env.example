# Create .env with no access for anyone else before any secret goes in:
#   install -m 600 .env.example .env
# then replace every <placeholder>. .env holds the master key: keep a copy in your secret manager,
# never beside a backup.
#
# Use the generator on each line. The two database passwords go into a connection string, so they
# must be the hex the generator makes. Compose expands $ in unquoted and double-quoted values: if you
# choose the seed password yourself, wrap it in single quotes.

# The vault's public host name. Its DNS record points at this host, and ports 80 and 443 reach it.
EV_DOMAIN=<vault.example.com>

# The signed release image you verified with docs/VERIFYING.md, pinned by digest.
EV_IMAGE=ghcr.io/sabysabashvily/eclipsvault@sha256:<digest you verified>

# PostgreSQL superuser, for backups and restores. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=<superuser password>

# The vault's own database login, inserted into its connection string. Hex only: openssl rand -hex 32
EV_DB_APP_PASSWORD=<vault database password>

# Master key. Generate: openssl rand -base64 32
ECLIPSVAULT_KEK=<base64 32-byte master key>

# Earlier master keys, ;-separated, after a master key rotation. Blank until then.
ECLIPSVAULT_KEK_RETIRED=

# Audit signing key, base64 PKCS#8 P-256. Generate:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -pkeyopt ec_param_enc:named_curve \
#     | openssl pkcs8 -topk8 -nocrypt -outform DER | openssl base64 -A
ECLIPSVAULT_AUDIT_SIGNING_KEY=<base64 audit signing key>

# vault-admin's first password, read only on an empty vault. Clear this line after the first start.
# Generate: openssl rand -hex 24
Seed__AdminPassword=<a password unique to this deployment>

# Your EVLIC1 licence token. Leave blank to run Community.
ECLIPSVAULT_LICENSE=
