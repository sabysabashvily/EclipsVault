<Project>

  <!-- Central Package Management: every package version is pinned here (exact, not floating)
       so restores are reproducible and a toolchain bump can't silently pull a new minor.
       Referencing projects list <PackageReference> without a Version attribute. -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data / EF Core -->
    <!-- OpenID Connect: SSO against the customer's own IdP, rather than a dependency on ours. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- PostgreSQL is a first-class target: SQL Server licensing is a line item on every
         self-hosted deployment, and the chain lock was the only thing tying the vault to it. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Test-only: lets the real DbContext run in-process so persistence invariants are pinned in CI. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- The SQLite provider still resolves the native library at 2.1.11, which carries a high-severity
         advisory (GHSA-2m69-gcr7-jv3q). Test-only and never shipped, but a known-vulnerable package has
         no business in a vault's dependency tree — pinned forward to the patched build. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- Microsoft.Data.SqlClient still resolves 9.0.4, which carries CVE-2026-84008 (high) and
         CVE-2026-70162 (moderate), both .NET denial-of-service fixes from 2026-10-13. Transitive
         pinning lifts it to the patched build until SqlClient takes it up itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />

    <!-- Crypto / encoding -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.9" />

    <!-- Distributed state -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />

    <!-- Media -->
    <!-- SkiaSharp ships the native libSkiaSharp for Windows and macOS only; the Linux asset is a
         separate package. NoDependencies is the build with no fontconfig/freetype system deps, which
         is what the slim aspnet runtime image and the CI runners need. Keep both on one version. -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Integration tests only: host the real app over HTTP against a SQL Server container, and run
         migrations on SQL Server and PostgreSQL containers, and exercise the Redis session registry. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
  </ItemGroup>

</Project>
