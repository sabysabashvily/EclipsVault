{
  "//": "Copy this file to appsettings.Development.json (which is git-ignored) and fill in local values. Nothing here should ever be a real/production secret.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EclipsVaultUmbraDb;Username=eclipsvault;Password=dev-postgres-password"
  },
  "Database": {
    "//": "Matches the PostgreSQL db container from docker-compose, whose password is public in that file. To develop against SQL Server instead, see 'Choosing the database' in README.md.",
    "Provider": "Postgres"
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Crypto": {
    "AllowDevelopmentKekFallback": true,
    "DevelopmentKekBase64": "<base64 of a 32-byte dev-only KEK; NOT for any real deployment>"
  },
  "AuditSigning": {
    "AllowDevelopmentEphemeralKey": true
  },
  "Email": {
    "//": "Deliver notifications to the Mailpit container from docker-compose. View them at http://localhost:8025.",
    "Sender": "Smtp",
    "Enabled": true,
    "Smtp": { "Host": "localhost", "Port": 1025, "UseSsl": false }
  },
  "Redis": {
    "//": "Optional locally. Set Enabled=true to exercise the Redis-backed distributed state against the redis container from docker-compose. Leave false for the zero-infrastructure in-process stores. The password matches docker-compose's --requirepass: local Redis is authenticated too, so the configuration you develop against is the one that is safe to deploy.",
    "Enabled": false,
    "Configuration": "localhost:6379,password=dev-redis-password"
  },
  "Seed": {
    "AdminPassword": "<local dev admin password>",
    "DevPassword": "<local dev user password>"
  }
}
