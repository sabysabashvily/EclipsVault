@using EclipsVault.Web.Extensions
@model EditUserViewModel
@{
    ViewData["Title"] = $"Edit {Model.Username}";
}

<div class="page-header">
    <div>
        <h1>Edit user</h1>
        <p class="page-sub"><span class="mono">@Model.Username</span> — @Model.DisplayName</p>
    </div>
    <div class="page-actions">
        <a class="button" href="/Admin/Users">Back to users</a>
    </div>
</div>

<section class="panel narrow-left">
    <div class="panel-header"><h2>Role &amp; access</h2></div>
    <form asp-action="EditUser" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />
        <input type="hidden" asp-for="DisplayName" />

        <div class="field-row">
            <div class="field">
                <label asp-for="Clearance"></label>
                <select asp-for="Clearance" asp-items="EnumDisplay.ClearanceSelectList()"></select>
            </div>
            <div class="field">
                <label asp-for="ProjectKey"></label>
                <input asp-for="ProjectKey" />
                <span asp-validation-for="ProjectKey" class="field-error"></span>
            </div>
        </div>

        <p class="hint muted">
            Clearance gates which sensitivity levels the user can read; the project key scopes
            them to that project (TopSecret sees all projects). Saving revokes the user's active
            sessions so the new access applies at their next sign-in.
            @if (Model.IsSelf)
            {
                <text><br /><strong>This is your own account</strong> — you cannot remove the last administrator's clearance.</text>
            }
        </p>

        <button type="submit" class="button primary">Save role</button>
    </form>
</section>
