@using EclipsVault.Web.Extensions
@model UsersViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div>
        <h1>Users</h1>
        <p class="page-sub">Staff accounts. New users set up their authenticator at first sign-in.</p>
    </div>
    <div class="page-actions">
        <a class="button primary" asp-action="CreateUser">New user</a>
    </div>
</div>

<section class="panel">
    <div class="table-toolbar">
        <input type="search" class="table-search" placeholder="Filter by name, project, clearance…" data-filter="#users-table" aria-label="Filter users" />
    </div>
    <table class="data-table" id="users-table">
        <thead>
            <tr>
                <th>User</th>
                <th>Clearance</th>
                <th>Project</th>
                <th>MFA</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var isSelf = user.Id == Model.CurrentUserId;
                var avatar = Url.Content($"~/Profile/Avatar?id={user.Id}&seed={Uri.EscapeDataString(user.DisplayName)}&v={(user.HasCustomAvatar ? "c" : "g")}");
                <tr class="@(user.IsDisabled ? "row-muted" : "")">
                    <td>
                        <div class="user-cell">
                            <img class="avatar-sm" src="@avatar" alt="" width="30" height="30" />
                            <div class="user-cell-text">
                                <span class="cell-strong">@user.DisplayName @(isSelf ? Html.Raw("<span class=\"badge\">you</span>") : Html.Raw(""))</span>
                                <span class="mono muted user-cell-sub">@user.Username · @user.Email</span>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge sens-@((int)user.Clearance)">@user.Clearance.ToDisplayName()</span></td>
                    <td>@user.ProjectKey</td>
                    <td>
                        @if (user.TotpEnabled)
                        {
                            <span class="badge tone-ok">Enrolled</span>
                        }
                        else
                        {
                            <span class="badge tone-warn">Pending</span>
                        }
                    </td>
                    <td>
                        @if (user.IsDisabled)
                        {
                            <span class="badge tone-danger">Disabled</span>
                        }
                        else if (user.IsLockedOut)
                        {
                            <span class="badge tone-warn">Locked</span>
                        }
                        else
                        {
                            <span class="badge tone-ok">Active</span>
                        }
                    </td>
                    <td class="cell-actions">
                        <a class="button small" asp-action="EditUser" asp-route-id="@user.Id">Edit</a>
                        @if (user.IsLockedOut)
                        {
                            <form class="inline-form" asp-action="Unlock" asp-route-id="@user.Id" method="post">
                                <button type="submit" class="button small">Unlock</button>
                            </form>
                        }
                        @if (user.IsDisabled)
                        {
                            <form class="inline-form" asp-action="SetEnabled" asp-route-id="@user.Id" method="post">
                                <input type="hidden" name="enabled" value="true" />
                                <button type="submit" class="button small">Enable</button>
                            </form>
                        }
                        else if (!isSelf)
                        {
                            <form class="inline-form" asp-action="SetEnabled" asp-route-id="@user.Id" method="post"
                                  data-confirm="Disable '@user.Username'? They will be signed out immediately and cannot sign in until re-enabled.">
                                <input type="hidden" name="enabled" value="false" />
                                <button type="submit" class="button small">Disable</button>
                            </form>
                        }
                        <details class="row-menu">
                            <summary class="button small">More</summary>
                            <div class="row-menu-panel">
                                <form class="inline-form" asp-action="ForceLogout" asp-route-id="@user.Id" method="post"
                                      data-confirm="Revoke all active sessions for '@user.Username'?">
                                    <button type="submit" class="menu-item">Force logout</button>
                                </form>
                                <form class="inline-form" asp-action="ResetTotp" asp-route-id="@user.Id" method="post"
                                      data-confirm="Reset MFA for '@user.Username'? They will re-enroll at next sign-in.">
                                    <button type="submit" class="menu-item">Reset MFA</button>
                                </form>
                                @if (!isSelf)
                                {
                                    <form class="inline-form" asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                          data-confirm="Delete user '@user.Username' permanently? This is audited.">
                                        <button type="submit" class="menu-item danger">Delete user</button>
                                    </form>
                                }
                            </div>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
