@using EclipsVault.Web.Extensions
@model CreateUserViewModel
@{
    ViewData["Title"] = "New user";
}

<div class="page-header">
    <div>
        <h1>New user</h1>
        <p class="page-sub">The email is generated automatically from the name; the password is Argon2id-hashed. TOTP enrollment happens at first sign-in.</p>
    </div>
    <div class="page-actions">
        <a class="button" asp-action="Users">Back to users</a>
    </div>
</div>

<section class="panel narrow-left">
    <form asp-action="CreateUser" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field-row">
            <div class="field">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" autocomplete="off" placeholder="Saba" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" autocomplete="off" placeholder="Sabashvili" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="off" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" data-reveal data-strength
                       data-breach-check="/api/ui/passwords/check-breached" data-breach-status="#new-user-password-breach" />
                <span asp-validation-for="Password" class="field-error"></span>
                <p id="new-user-password-breach" class="field-note" role="status" aria-live="polite"></p>
            </div>
        </div>

        <p class="hint muted">
            Passwords are screened against a corpus of values exposed in public breaches and rejected
            if compromised (NIST 800-63B). At least 12 characters.
        </p>

        <p class="hint muted">
            The email is generated as <code>firstname.lastname.N@@eclipsvault.local</code>, where
            <code>N</code> increments for people who share a name — so a second "Saba Sabashvili"
            becomes <code>saba.sabashvili.2@@…</code>. The user can sign in with either the username or this email.
        </p>

        <div class="field-row">
            <div class="field">
                <label asp-for="Clearance"></label>
                <select asp-for="Clearance" asp-items="EnumDisplay.ClearanceSelectList()"></select>
            </div>
            <div class="field">
                <label asp-for="ProjectKey"></label>
                <input asp-for="ProjectKey" placeholder="PHOENIX" />
                <span asp-validation-for="ProjectKey" class="field-error"></span>
            </div>
        </div>

        <p class="hint muted">
            Clearance gates which sensitivity levels the user can read; the project key
            scopes them to their project's secrets (TopSecret clearance sees all projects).
            Note: network trust is evaluated per request from the connecting address — it
            is a property of the network, not of the account.
        </p>

        <button type="submit" class="button primary">Create user</button>
    </form>
</section>
