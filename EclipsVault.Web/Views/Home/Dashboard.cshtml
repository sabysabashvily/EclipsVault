@model DashboardViewModel
@{
    ViewData["Title"] = "Overview";
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Overview</h1>
        <p class="page-sub">Welcome back, @Model.Username. Here is the vault at a glance.</p>
    </div>
    <div class="page-actions">
        <a class="button primary" asp-controller="Secrets" asp-action="Create">New secret</a>
    </div>
</div>

@if (Model.ExpiringSoon.Count > 0)
{
    <div class="notice notice-warn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
        <span><strong>@Model.ExpiringSoon.Count secret@(Model.ExpiringSoon.Count == 1 ? "" : "s")</strong> will expire within 7 days and be shredded automatically. Rotate them to extend their life.</span>
    </div>
}

<div class="stat-grid">
    <a class="stat-card" asp-controller="Secrets" asp-action="Index">
        <span class="stat-value">@Model.TotalActiveSecrets</span>
        <span class="stat-label">Active secrets</span>
        <span class="stat-detail">@Model.DevelopmentCount dev · @Model.StagingCount staging · @Model.ProductionCount prod</span>
    </a>
    <a class="stat-card @(Model.ExpiringWithin7Days > 0 ? "attention" : "")" asp-controller="Secrets" asp-action="Index">
        <span class="stat-value">@Model.ExpiringWithin7Days</span>
        <span class="stat-label">Expiring within 7 days</span>
        <span class="stat-detail">Shredded automatically at TTL</span>
    </a>
    @if (Model.IsAdmin)
    {
        <a class="stat-card @(Model.CriticalEventsLast24h > 0 ? "alert" : "")" asp-controller="Audit" asp-action="Index">
            <span class="stat-value">@Model.CriticalEventsLast24h</span>
            <span class="stat-label">Critical alerts (24 h)</span>
            <span class="stat-detail">@(Model.CriticalEventsLast24h > 0 ? "Review the audit log →" : "All quiet")</span>
        </a>
        <a class="stat-card" href="/Admin/Users">
            <span class="stat-value">@Model.UserCount</span>
            <span class="stat-label">Staff accounts</span>
            <span class="stat-detail">Manage users →</span>
        </a>
    }
    else
    {
        <div class="stat-card @(Model.CriticalEventsLast24h > 0 ? "alert" : "")">
            <span class="stat-value">@Model.CriticalEventsLast24h</span>
            <span class="stat-label">Critical alerts (24 h)</span>
            <span class="stat-detail">@(Model.CriticalEventsLast24h > 0 ? "Reported to administrators" : "All quiet")</span>
        </div>
    }
</div>

<div class="two-col">
    <section class="panel">
        <div class="panel-header">
            <h2>@(Model.IsAdmin ? "Recent activity" : "Your recent activity")</h2>
            @if (Model.IsAdmin)
            {
                <a class="button small" asp-controller="Audit" asp-action="Index">Full audit log</a>
            }
        </div>
        @if (Model.RecentEvents.Count == 0)
        {
            <p class="muted">No recorded activity yet.</p>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var entry in Model.RecentEvents)
                {
                    var (label, tone) = AuditDisplay.For(entry.Action);
                    <li class="activity-item @(entry.IsCritical ? "critical" : "")">
                        <span class="badge tone-@tone">@label</span>
                        <span class="activity-target mono">@(entry.ResourceName ?? entry.ResourceType)</span>
                        <span class="activity-meta">@entry.Username · @AuditDisplay.Ago(entry.TimestampUtc, now)</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Quick actions</h2></div>
        <div class="quick-actions">
            <a class="quick-action" asp-controller="Secrets" asp-action="Index">
                <strong>Browse secrets</strong>
                <span class="muted">Metadata only — reveals are audited</span>
            </a>
            <a class="quick-action" asp-controller="Secrets" asp-action="Create">
                <strong>Store a new secret</strong>
                <span class="muted">AES-256-GCM envelope encryption</span>
            </a>
            @if (Model.IsAdmin)
            {
                <a class="quick-action" asp-controller="Admin" asp-action="CreateUser">
                    <strong>Provision a user</strong>
                    <span class="muted">TOTP enrollment at first sign-in</span>
                </a>
                <a class="quick-action" asp-controller="Admin" asp-action="Networks">
                    <strong>Manage trusted networks</strong>
                    <span class="muted">Trust your current IP, lift blocks</span>
                </a>
            }
        </div>
    </section>
</div>

@if (Model.ExpiringSoon.Count > 0)
{
    <section class="panel">
        <div class="panel-header">
            <h2>Expiring soon</h2>
            <a class="button small" asp-controller="Secrets" asp-action="Index">All secrets</a>
        </div>
        <table class="data-table">
            <thead><tr><th>Name</th><th>Environment</th><th>Expires (UTC)</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model.ExpiringSoon)
                {
                    var until = s.ExpiresAtUtc - now;
                    var withinDay = until <= TimeSpan.FromDays(1);
                    var untilLabel = until <= TimeSpan.Zero ? "now"
                        : until < TimeSpan.FromDays(1) ? $"in {Math.Max(1, (int)until.TotalHours)}h"
                        : $"in {(int)until.TotalDays}d";
                    <tr>
                        <td class="mono cell-strong">@s.Name</td>
                        <td><span class="badge env-@s.Environment.ToString().ToLowerInvariant()">@s.Environment</span></td>
                        <td class="muted">
                            @s.ExpiresAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")
                            <span class="badge @(withinDay ? "tone-danger" : "tone-warn")">@untilLabel</span>
                        </td>
                        <td class="cell-actions"><a class="button small" asp-controller="Secrets" asp-action="Details" asp-route-id="@s.Id">Rotate</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
