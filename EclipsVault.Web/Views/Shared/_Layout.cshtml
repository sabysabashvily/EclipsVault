@using System.Security.Claims
@using EclipsVault.Web.Extensions
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAdmin = User.IsAdmin();
    var clearanceName = User.GetClearanceOrNull()?.ToDisplayName();
    var displayName = User.FindFirstValue(VaultClaimTypes.Display) ?? User.Identity?.Name ?? "";
    var avatarVersion = User.FindFirstValue(VaultClaimTypes.AvatarVersion) ?? "0";
    var avatarUrl = Url.Content($"~/Profile/Avatar?v={avatarVersion}");
    var theme = Context.Request.Cookies["EclipsVault.Theme"] == "light" ? "light" : "dark";

    // Sub-pages of the Secrets controller that have their own nav entry, so the plain
    // "Secrets" item should not also highlight on them.
    var secretsSubPages = new[] { "Create", "SharedWithMe", "SharedByMe" };
    string Nav(string c, string? a = null) =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        && (a is null || action.Equals(a, StringComparison.OrdinalIgnoreCase))
        && (a is not null || c != "Secrets" || !secretsSubPages.Contains(action, StringComparer.OrdinalIgnoreCase))
            ? "nav-item active" : "nav-item";

    // True when the current page is one of a collapsible group's children — so the group opens
    // itself and marks its header, keeping the active item visible without any script.
    bool GroupActive(params (string C, string? A)[] items) =>
        items.Any(i => controller.Equals(i.C, StringComparison.OrdinalIgnoreCase)
            && (i.A is null || action.Equals(i.A, StringComparison.OrdinalIgnoreCase)));

    var shareActive = GroupActive(("Secrets", "SharedWithMe"), ("Secrets", "SharedByMe"));
    var accessActive = GroupActive(("Access", null), ("AccessRequests", null));
    var securityActive = GroupActive(("Security", null), ("SignIns", null), ("Sessions", null), ("Activity", null));
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EclipsVault</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<div class="shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">EclipsVault</span>
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            @* The palette's front door. A keyboard shortcut nobody can see is a feature only its
               author uses, so the shortcut gets a thing to point at: this looks like a search
               field, opens the palette when clicked, and shows the chord beside it. It is a
               button rather than an <input> on purpose — it never accepts typing itself, and a
               field that ignores your keystrokes and opens a dialog instead is a small betrayal.
               site.js swaps the ⌘ for Ctrl off the Mac. *@
            <button type="button" class="command-trigger" data-command-open
                    aria-label="Search secrets or jump to a page">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <span class="command-trigger-label">Search…</span>
                <kbd data-command-chord>⌘K</kbd>
            </button>

            @* data-command-source marks this nav as where the ⌘K palette reads its "Go to" entries
               from. It reads the links that are actually here, which is what keeps the palette
               honest: this nav is already rendered per-caller — an admin-only entry is not in the
               DOM for anyone else — so the palette can only ever offer routes this user was
               already offered. The signed-out nav below is deliberately not marked. *@
            <nav class="sidenav" data-command-source
                 data-command-search="@Url.Action("Search", "Secrets")">
                <span class="nav-section">Vault</span>
                <a class="@Nav("Home", "Index")" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    Overview
                </a>
                <a class="@Nav("Secrets")" asp-controller="Secrets" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r="1.4"/></svg>
                    Secrets
                </a>
                <a class="@Nav("Secrets", "Create")" asp-controller="Secrets" asp-action="Create">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
                    New secret
                </a>
                <a class="@Nav("DynamicSecrets")" asp-controller="DynamicSecrets" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
                    Dynamic secrets
                </a>
                <details class="nav-group" open="@(shareActive ? "open" : null)">
                    <summary class="nav-item nav-group-summary@(shareActive ? " has-active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.7l7.4-4.4M8.3 13.3l7.4 4.4"/></svg>
                        <span>Sharing</span>
                        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </summary>
                    <div class="nav-group-items">
                        <a class="@Nav("Secrets", "SharedWithMe")" asp-controller="Secrets" asp-action="SharedWithMe">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.7l7.4-4.4M8.3 13.3l7.4 4.4"/></svg>
                            Shared with me
                        </a>
                        <a class="@Nav("Secrets", "SharedByMe")" asp-controller="Secrets" asp-action="SharedByMe">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.4 2.8-5 5.5-5 1.3 0 2.5.4 3.4 1"/><path d="M16 15h6M19 12l3 3-3 3"/></svg>
                            Shared by me
                        </a>
                    </div>
                </details>

                @* "Profile" used to sit here as well as on the card at the foot of this sidebar —
                   two entries, one destination, about 500px apart. It lives on the card now,
                   which is where a face and a name already promise it goes. *@
                <span class="nav-section">Account</span>
                <details class="nav-group" open="@(accessActive ? "open" : null)">
                    <summary class="nav-item nav-group-summary@(accessActive ? " has-active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="14" r="3.5"/><path d="M9.5 11.5 20 1M17 4l2 2M14 7l2 2"/></svg>
                        <span>Access</span>
                        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </summary>
                    <div class="nav-group-items">
                        <a class="@Nav("Access")" asp-controller="Access" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="m10.5 15 1.2 1.2 2.3-2.4"/></svg>
                            My access
                        </a>
                        <a class="@Nav("AccessRequests")" asp-controller="AccessRequests" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6a1 1 0 0 1 1 1v1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h2V5a1 1 0 0 1 1-1Z"/><path d="M9 14l2 2 4-4"/></svg>
                            Access requests
                        </a>
                    </div>
                </details>
                <details class="nav-group" open="@(securityActive ? "open" : null)">
                    <summary class="nav-item nav-group-summary@(securityActive ? " has-active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/></svg>
                        <span>Security</span>
                        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </summary>
                    <div class="nav-group-items">
                        <a class="@Nav("Security")" asp-controller="Security" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                            Security checkup
                        </a>
                        <a class="@Nav("SignIns")" asp-controller="SignIns" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3"/><path d="M8 7l5 5-5 5M13 12H3"/></svg>
                            Sign-in history
                        </a>
                        <a class="@Nav("Sessions")" asp-controller="Sessions" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="14" height="10" rx="1.6"/><path d="M6 18h6M9 14v4"/><rect x="17" y="9" width="5" height="11" rx="1.4"/></svg>
                            Signed-in devices
                        </a>
                        <a class="@Nav("Activity")" asp-controller="Activity" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-7 4 14 2.5-7H21"/></svg>
                            My activity
                        </a>
                    </div>
                </details>
                <a class="@Nav("Data")" asp-controller="Data" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 12v5M9.5 14.5 12 17l2.5-2.5"/></svg>
                    Your data
                </a>

                @if (isAdmin)
                {
                    <span class="nav-section">Administration</span>
                    <a class="@Nav("Admin", "Users")" asp-controller="Admin" asp-action="Users">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.4 2.8-5 5.5-5s4.9 1.6 5.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.6c2.6.2 4.4 1.7 5 4.9"/></svg>
                        Users
                    </a>
                    <a class="@Nav("Admin", "Networks")" asp-controller="Admin" asp-action="Networks">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.7 2.6 4 5.7 4 9s-1.3 6.4-4 9c-2.7-2.6-4-5.7-4-9s1.3-6.4 4-9Z"/></svg>
                        Networks
                    </a>
                    <a class="@Nav("ServiceAccounts")" asp-controller="ServiceAccounts" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/></svg>
                        Service accounts
                    </a>
                    <a class="@Nav("Audit")" asp-controller="Audit" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
                        Audit log
                    </a>
                    <a class="@Nav("Notifications")" asp-controller="Notifications" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l8 6 8-6"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>
                        Notifications
                    </a>
                    <a class="@Nav("Encryption")" asp-controller="Encryption" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2"/></svg>
                        Encryption keys
                    </a>
                    <a class="@Nav("License")" asp-controller="License" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h6M7 13h4"/><circle cx="16.3" cy="13.6" r="2.2"/><path d="m14.9 15.2-.6 2.3 2-1 2 1-.6-2.3"/></svg>
                        License
                    </a>
                }
            </nav>

            @* One account control instead of three.
               This used to be a profile link, a theme toggle and a sign-out button crammed side
               by side into a 244px rail — which is why a name as ordinary as "Devon Rhodes" kept
               getting clipped to "Devon Rhod…": the two fixed icons were taking the width from
               it. Folding them into a menu is not just tidier, it hands the name the whole row,
               and it puts sign-out where people have been trained for a decade to look for it —
               behind their own face.

               Native <details>, like the row menus elsewhere: it opens with no script and so
               cannot be broken by the CSP, and wireMenus() already closes any open one when you
               click away. The clearance is a plain word with no "clearance" after it because the
               line still has to fit next to a 34px avatar. *@
            <div class="sidebar-footer">
                <details class="account-menu">
                    <summary class="user-card" aria-haspopup="menu"
                             title="@(clearanceName is null ? "Your account" : $"Your account — {clearanceName} clearance")">
                        <img class="avatar-img" src="@avatarUrl" alt="" width="34" height="34" />
                        <span class="user-meta">
                            <span class="user-name">@displayName</span>
                            @if (clearanceName is not null)
                            {
                                <span class="user-clearance">@clearanceName</span>
                            }
                        </span>
                        <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 15l4-4 4 4"/></svg>
                    </summary>

                    @* Also a command source: Profile moved out of the nav into here, and the
                       palette harvests links from the marked containers — so without this, taking
                       the nav item away would have quietly dropped Profile out of ⌘K too. Sign out
                       is a form button, not a link, so it is not harvested; a palette that can log
                       you out on a mistyped Enter is not a convenience. *@
                    <div class="account-menu-panel" role="menu" data-command-source>
                        <a class="menu-item" role="menuitem" href="/Profile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.6-3.7 3-6 6.5-6s5.9 2.3 6.5 6"/></svg>
                            Profile
                        </a>
                        <button type="button" class="menu-item" role="menuitem" data-theme-toggle>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16a8 8 0 0 0 0-16Z" fill="currentColor" stroke="none"/></svg>
                            <span data-theme-label>Switch appearance</span>
                        </button>
                        <div class="menu-sep" role="separator"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="menu-item danger" role="menuitem">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
                                Sign out
                            </button>
                        </form>
                    </div>
                </details>
            </div>
        }
        else
        {
            <nav class="sidenav">
                <a class="nav-item" asp-controller="Account" asp-action="Login">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3"/><path d="M8 7l5 5-5 5M13 12H3"/></svg>
                    Sign in
                </a>
            </nav>

            <div class="sidebar-footer">
                <partial name="_ThemeToggle" />
            </div>
        }
    </aside>

    <main class="content">
        <partial name="_Flash" />
        @* Admin-only: a licensing reminder is only useful to whoever can act on it, and nagging every
           user about the operator's license would just degrade their experience. *@
        @if (isAdmin)
        {
            <partial name="_LicenseBanner" />
        }
        @RenderBody()
        <footer class="content-footer">
            EclipsVault — envelope-encrypted secret management. Everything is audited.
        </footer>
    </main>
</div>
</body>
</html>
