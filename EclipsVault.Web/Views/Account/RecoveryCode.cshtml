@model RecoveryCodeViewModel
@{
    ViewData["Title"] = "Use a recovery code";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <div class="step-track" aria-hidden="true"><span class="step done"></span><span class="step active"></span></div>
    <h1>Use a recovery code</h1>
    <p class="muted">Step 2 of 2 — enter one of the single-use recovery codes you saved when you set up MFA. Each code works only once.</p>

    <form asp-action="RecoveryCode" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="code-input" autocomplete="one-time-code"
                   autocapitalize="characters" spellcheck="false" maxlength="16" placeholder="XXXXX-XXXXX" autofocus />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>

        <button type="submit" class="button primary wide">Verify and sign in</button>
    </form>

    <p class="footnote">
        Have your authenticator? <a asp-action="Totp" asp-route-ReturnUrl="@Model.ReturnUrl">Enter a 6-digit code instead</a>.
    </p>
</section>
