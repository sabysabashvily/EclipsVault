@model TotpViewModel
@{
    ViewData["Title"] = "Two-factor verification";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <div class="step-track" aria-hidden="true"><span class="step done"></span><span class="step active"></span></div>
    <h1>Two-factor verification</h1>
    <p class="muted">Step 2 of 2 — enter the 6-digit code from your authenticator app.</p>

    <form asp-action="Totp" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>

        <button type="submit" class="button primary wide">Verify and sign in</button>
    </form>

    <p class="footnote">
        Lost your authenticator? <a asp-action="RecoveryCode" asp-route-ReturnUrl="@Model.ReturnUrl">Use a recovery code</a>.
    </p>
</section>
