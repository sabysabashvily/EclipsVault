@model EnrollTotpViewModel
@{
    ViewData["Title"] = "Set up two-factor authentication";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <div class="step-track" aria-hidden="true"><span class="step done"></span><span class="step active"></span></div>
    <h1>Set up two-factor authentication</h1>
    <p class="muted">
        Multi-factor sign-in is mandatory. Add this account to your authenticator app
        (Google Authenticator, 1Password, Authy, …) and confirm with a code.
    </p>

    <div class="totp-secret">
        <p><strong>Scan this QR code with your authenticator app</strong></p>
        <img class="totp-qr" src="@Model.QrCodeDataUri" alt="QR code containing the authenticator enrollment secret" />
        <p class="muted">Can't scan it? Enter this key manually:</p>
        <code class="secret-code">@Model.SecretBase32</code>
    </div>

    <form asp-action="EnrollTotp" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>

        <button type="submit" class="button primary wide">Confirm enrollment</button>
    </form>
</section>
