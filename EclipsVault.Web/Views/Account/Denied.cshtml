@using EclipsVault.Web.Extensions
@model AccessDeniedViewModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="page-header">
    <div>
        <h1>Access denied</h1>
        <p class="page-sub">The attribute-based access policy rejected this request.</p>
    </div>
</div>

<section class="panel narrow-left">
    @if (Model.Reasons.Count > 0)
    {
        <p>Access was refused because:</p>
        <ul class="denial-reasons">
            @foreach (var reason in Model.Reasons)
            {
                <li>@reason</li>
            }
        </ul>
        <p class="muted">Access is granted only when every requirement above is satisfied. The attempt has been logged.</p>
    }
    else
    {
        <p>
            Your clearance, project assignment, the time window, or your network
            location did not satisfy the resource's requirements. The attempt has
            been logged.
        </p>
    }
    <div class="button-row">
        <a class="button" asp-controller="Secrets" asp-action="Index">Back to secrets</a>
        @if (User.IsAdmin())
        {
            <a class="button" asp-controller="Admin" asp-action="Networks">Manage trusted networks</a>
        }
    </div>
</section>

@if (Model.SecretId is { } secretId)
{
    <section class="panel narrow-left">
        <div class="panel-header"><h2>Request access</h2></div>
        @if (Model.RequestRefusalMessage is { } refusal)
        {
            <p class="muted">@refusal</p>
        }
        else
        {
            <p class="muted">Ask a reviewer, an administrator or a member of this secret's project who can open it, to share it with you.</p>
            <form asp-controller="AccessRequests" asp-action="Create" method="post">
                <input type="hidden" name="secretId" value="@secretId" />
                <div class="field">
                    <label for="reason">Reason</label>
                    <textarea id="reason" name="reason" rows="3" maxlength="500" placeholder="Why do you need this secret?"></textarea>
                </div>
                <button type="submit" class="button primary">Submit request</button>
            </form>
        }
    </section>
}
