@using EclipsVault.Web.Extensions
@model ServiceAccountDetailsViewModel
@{
    ViewData["Title"] = Model.Account.Name;
    var account = Model.Account;
}

<div class="page-header">
    <div>
        <h1 class="mono">@account.Name</h1>
        <p class="page-sub">
            <span class="badge sens-@((int)account.Clearance)">@account.Clearance.ToDisplayName()</span>
            <span class="badge">@account.ProjectKey</span>
            @if (account.IsDisabled)
            {
                <span class="badge tone-danger">Disabled</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="button" asp-action="Index">Back</a>
    </div>
</div>

@if (Model.NewlyIssuedToken is not null)
{
    <div class="revealed-box">
        <div class="revealed-head">
            <strong>New API key — copy it now</strong>
            <button type="button" class="button small" data-copy="#new-token">Copy</button>
        </div>
        <code class="secret-code" id="new-token">@Model.NewlyIssuedToken</code>
        <p class="muted">This token is shown only once and is not stored. Present it as <code>Authorization: Bearer &lt;token&gt;</code> or <code>X-Api-Key: &lt;token&gt;</code>.</p>
    </div>
}

<div class="two-col">
    <section class="panel">
        <div class="panel-header"><h2>API keys</h2></div>

        <form class="issue-key-form" asp-action="IssueKey" asp-route-id="@account.Id" method="post">
            <div class="field-inline-row">
                <div class="field">
                    <label>Expires in (days)</label>
                    <input name="ttlDays" type="number" min="0" max="3650" value="0" title="0 = no expiry" />
                </div>
                <div class="field">
                    <label>Clearance ceiling</label>
                    <select name="clearanceCeiling">
                        <option value="0">No limit (account: @account.Clearance.ToDisplayName())</option>
                        @foreach (var level in Enum.GetValues<ClearanceLevel>().Where(clearance => (int)clearance < (int)account.Clearance))
                        {
                            <option value="@((int)level)">at most @level.ToDisplayName()</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field-inline-row">
                <div class="field">
                    <label>Project scope</label>
                    <input name="projectScope" maxlength="64" autocomplete="off" placeholder="blank = account (@account.ProjectKey)" />
                </div>
                <label class="check-inline">
                    <input type="checkbox" name="metadataOnly" value="true" />
                    <span>Metadata only — can list, cannot read values</span>
                </label>
            </div>
            <div class="field">
                <label>Allowed source ranges <span class="muted">(optional)</span></label>
                <input name="allowedCidrs" maxlength="512" autocomplete="off"
                       placeholder="e.g. 203.0.113.0/24, 10.8.0.5 — blank = any network" />
                <span class="hint muted">Comma- or space-separated IPs / CIDRs. A key presented from any other address is rejected, so a leaked key is useless off-network.</span>
            </div>
            <button type="submit" class="button primary">Issue new key</button>
            <p class="hint muted">Scopes only ever <strong>narrow</strong> a key below this account — never widen it. Leave them empty for a full-access key.</p>
        </form>

        @if (account.Keys.Count == 0)
        {
            <p class="muted">No keys yet. Issue one so this account can authenticate.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>Key</th><th>Scope</th><th>Created</th><th>Expires</th><th>Last used</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var key in account.Keys)
                        {
                            var isKeyActive = key.Status == ApiKeyStatus.Active;
                            <tr class="@(isKeyActive ? "" : "row-muted")">
                                <td class="mono cell-strong">@key.Prefix…</td>
                                <td>
                                    @if (!key.IsScoped)
                                    {
                                        <span class="badge tone-muted">full access</span>
                                    }
                                    else
                                    {
                                        <span class="key-scopes">
                                            @if (key.MetadataOnly)
                                            {
                                                <span class="badge tone-warn">metadata-only</span>
                                            }
                                            @if (key.ClearanceCeiling is { } clearanceCeiling)
                                            {
                                                <span class="badge tone-muted">at most @clearanceCeiling</span>
                                            }
                                            @if (!string.IsNullOrEmpty(key.ProjectScope))
                                            {
                                                <span class="badge tone-muted">@key.ProjectScope</span>
                                            }
                                            @if (key.AllowedCidrs.Count > 0)
                                            {
                                                <span class="badge tone-ok" title="@string.Join(", ", key.AllowedCidrs)">@key.AllowedCidrs.Count network@(key.AllowedCidrs.Count == 1 ? "" : "s")</span>
                                            }
                                        </span>
                                    }
                                </td>
                                <td class="muted">@key.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd")</td>
                                <td class="muted">@(key.ExpiresAtUtc?.UtcDateTime.ToString("yyyy-MM-dd") ?? "never")</td>
                                <td class="muted">@(key.LastUsedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>
                                    @if (key.Status == ApiKeyStatus.Revoked)
                                    {
                                        <span class="badge tone-danger">Revoked</span>
                                    }
                                    else if (key.Status == ApiKeyStatus.Expired)
                                    {
                                        <span class="badge tone-warn">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge tone-ok">Active</span>
                                    }
                                </td>
                                <td class="cell-actions">
                                    @if (isKeyActive)
                                    {
                                        <form class="inline-form" asp-action="RevokeKey" asp-route-id="@account.Id" asp-route-keyId="@key.Id" method="post"
                                              data-confirm="Revoke key @key.Prefix…? Any caller using it will stop working immediately.">
                                            <button type="submit" class="button small danger">Revoke</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Account</h2></div>
        <dl class="detail-grid">
            <dt>Clearance</dt>
            <dd><span class="badge sens-@((int)account.Clearance)">@account.Clearance.ToDisplayName()</span></dd>
            <dt>Project</dt>
            <dd>@account.ProjectKey</dd>
            <dt>Created (UTC)</dt>
            <dd>@account.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>

        <div class="settings-row">
            <div>
                <strong>@(account.IsDisabled ? "Enable" : "Disable") account</strong>
                <p class="muted">Disabling rejects every key without revoking them individually.</p>
            </div>
            <form asp-action="SetEnabled" asp-route-id="@account.Id" method="post">
                <input type="hidden" name="enabled" value="@((!account.IsDisabled).ToString().ToLowerInvariant())" />
                <button type="submit" class="button">@(account.IsDisabled ? "Enable" : "Disable")</button>
            </form>
        </div>

        <div class="danger-zone">
            <div>
                <strong>Delete this service account</strong>
                <p class="muted">Removes the account and all its keys. Audited.</p>
            </div>
            <form class="inline-form" asp-action="Delete" asp-route-id="@account.Id" method="post"
                  data-confirm="Delete service account '@account.Name' and all its API keys? This cannot be undone.">
                <button type="submit" class="button danger">Delete</button>
            </form>
        </div>
    </section>
</div>
