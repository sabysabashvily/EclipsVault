@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="page-header">
    <div>
        <h1>Change password</h1>
        <p class="page-sub">Confirm your current password, then choose a new one (at least 12 characters).</p>
    </div>
    <div class="page-actions">
        <a class="button" asp-action="Index">Back to profile</a>
    </div>
</div>

<section class="panel narrow-left">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" autofocus />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" data-reveal data-strength
                   data-breach-check="/api/ui/passwords/check-breached" data-breach-status="#new-password-breach" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
            <p id="new-password-breach" class="field-note" role="status" aria-live="polite"></p>
            <span class="hint muted">At least 12 characters. Checked against a corpus of passwords exposed in public breaches (NIST 800-63B).</span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="button primary">Change password</button>
    </form>
</section>
