@model AuditIndexViewModel
@{
    ViewData["Title"] = "Audit log";
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Audit log</h1>
        <p class="page-sub">Immutable, fail-closed trail — showing the latest @Model.Entries.Count entries.</p>
    </div>
    <form asp-action="Verify" method="post">
        <button type="submit" class="button">Verify integrity</button>
    </form>
</div>

@if (Model.Integrity is { } report)
{
    @if (report.Outcome == AuditChainOutcome.Anchored)
    {
        <div class="notice notice-ok">
            <strong>✓ Hash chain intact.</strong>
            <span>@report.Message</span>
        </div>
    }
    else if (report.Outcome == AuditChainOutcome.Unanchored)
    {
        <div class="notice notice-warn">
            <strong>✓ Hash chain intact, but no signed checkpoint covers it yet.</strong>
            <span>@report.Message</span>
        </div>
    }
    else
    {
        <div class="notice notice-critical">
            <strong>✗ Tampering detected.</strong>
            <span>@report.Message</span>
        </div>
    }
}

<section class="panel">
    <div class="panel-header">
        <h2>Attestation</h2>
        <span class="badge tone-muted mono">key @Model.SigningKeyId</span>
    </div>
    <p class="hint muted">
        The hash chain is tamper-evident to anyone with the database. A <strong>signed checkpoint</strong> goes further:
        it binds the chain head with an ECDSA signature, so an outside auditor can prove the trail hasn't been rewritten
        using only the public key — even against someone who deleted rows and recomputed every hash. Export a bundle and
        verify it offline with the <code>EclipsVault.AuditVerifier</code> tool.
    </p>

    <dl class="detail-grid">
        <dt>Latest checkpoint</dt>
        <dd>
            @if (Model.LatestCheckpoint is { } cp)
            {
                <text>sequence <strong>@cp.Sequence</strong> · @cp.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") · <span class="mono">@cp.SigningKeyId</span></text>
            }
            else
            {
                <span class="muted">none yet — create one to attest the current trail</span>
            }
        </dd>
    </dl>

    <div class="button-row">
        <form asp-action="CreateCheckpoint" method="post">
            <button type="submit" class="button">Create signed checkpoint</button>
        </form>
        <form asp-action="Export" method="post">
            <button type="submit" class="button primary">Export signed bundle</button>
        </form>
    </div>
</section>

<section class="panel">
    <div class="table-toolbar">
        <input type="search" class="table-search" placeholder="Filter by user, action, resource, IP…" data-filter="#audit-table" aria-label="Filter audit entries" />
    </div>
    <div class="table-scroll">
        <table class="data-table" id="audit-table">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Action</th>
                    <th>Resource</th>
                    <th>Actor</th>
                    <th>Source IP</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    var (label, tone) = AuditDisplay.For(entry.Action);
                    <tr class="@(entry.IsCritical ? "row-critical" : "")">
                        <td class="muted" title="@entry.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")">
                            @AuditDisplay.Ago(entry.TimestampUtc, now)
                        </td>
                        <td><span class="badge tone-@tone">@label</span></td>
                        <td class="mono">@(entry.ResourceName ?? entry.ResourceType)</td>
                        <td>@entry.Username</td>
                        <td class="mono muted">@entry.SourceIp</td>
                        <td class="muted cell-wrap">@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
