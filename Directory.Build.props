<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Quality gate: compiler, nullable, AND analyzer (CAxxxx) findings all fail the build,
         so a rule regression can't merge as a warning nobody reads. The one hazard of enforcing
         analyzers - a toolchain bump silently activating new rules that break CI - is closed by
         pinning AnalysisLevel to a fixed rule set rather than tracking 'latest'. Upgrading the
         analyzers is then a deliberate change: raise the level, fix whatever lights up, commit. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- Code style rules (IDExxxx) run in the build too, at the severities the root .editorconfig
         gives them, so a formatting slip fails here and not only under `dotnet format`. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible restores: versions are pinned centrally in Directory.Packages.props. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
