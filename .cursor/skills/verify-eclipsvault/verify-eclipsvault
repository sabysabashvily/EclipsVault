#!/usr/bin/env bash
# Launch, check, drive, and tear down one disposable EclipsVault for verification.
# Passwords, the KEK, and the audit signing key stay in logs/verify/instance/env.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
instance="$root/logs/verify/instance"
evidence="$root/logs/verify/evidence"
state="$instance/state.json"
env_file="$instance/env"
base_url="https://localhost:7443"
dll="$root/EclipsVault.Web/bin/Release/net10.0/EclipsVault.Web.dll"
compose=(docker compose --file "$root/docker-compose.yml")

die() { printf '%s\n' "$1" >&2; exit 1; }

database_name() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["database"])' "$state"
}

pid_from_state() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pid") or "")' "$state"
}

psql() {
  local database="$1"
  shift
  docker exec -e PGPASSWORD=dev-postgres-password eclipsvault-postgres \
    psql -v ON_ERROR_STOP=1 -h 127.0.0.1 -U eclipsvault -d "$database" "$@"
}

listening_pid() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true
    return
  fi
  ss -ltnp "sport = :$port" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -n 1
}

require_instance() {
  [[ -f "$state" ]] || die "No verification vault. Run verify-eclipsvault launch first."
}

process_args() {
  local pid="$1"
  if [[ -r "/proc/$pid/cmdline" ]]; then
    tr '\0' ' ' < "/proc/$pid/cmdline"
    return
  fi
  ps -p "$pid" -o args= 2>/dev/null || true
}

our_process() {
  local pid="$1"
  [[ -n "$pid" ]] || return 1
  process_args "$pid" | grep -q 'EclipsVault.Web.dll'
}

browser_process() {
  local pid="$1"
  [[ -n "$pid" && -f "$instance/browser.pid" ]] || return 1
  process_args "$pid" | grep -q 'browser.mjs daemon'
}

launch() {
  if [[ -f "$state" ]]; then
    local existing
    existing="$(pid_from_state || true)"
    if our_process "$existing"; then
      die "A verification vault is already running (pid $existing). Run doctor, or cleanup before launching another."
    fi
    die "logs/verify/instance is left from an earlier run. Run verify-eclipsvault cleanup before launching again."
  fi
  docker info >/dev/null 2>&1 || die "Docker is not running. Start it, then run launch again."
  local port pid
  for port in 7443 5080; do
    pid="$(listening_pid "$port" || true)"
    if [[ -n "$pid" ]]; then
      die "Port $port is already in use by pid $pid. This skill will not start a second vault on the shared dev ports."
    fi
  done

  mkdir -p "$instance" "$evidence"
  chmod 700 "$instance"

  "${compose[@]}" up -d --wait db
  psql EclipsVaultUmbraDb -c 'SELECT 1' >/dev/null

  local database password_admin password_dev kek audit_key
  database="evverify$(openssl rand -hex 4)"
  [[ "$database" =~ ^evverify[0-9a-f]{8}$ ]] || die "Refusing an unexpected database name."
  psql EclipsVaultUmbraDb -c "CREATE DATABASE \"$database\"" >/dev/null

  password_admin="E2e-$(openssl rand -hex 24)"
  password_dev="E2e-$(openssl rand -hex 24)"
  kek="$(openssl rand -base64 32 | tr -d '\n')"
  audit_key="$(node -e 'const {generateKeyPairSync}=require("crypto"); const {privateKey}=generateKeyPairSync("ec",{namedCurve:"prime256v1"}); process.stdout.write(privateKey.export({type:"pkcs8",format:"der"}).toString("base64"));')"
  # Single-quoted values: the connection string contains ';' which a shell would treat as a command.
  python3 - "$env_file" "$database" "$password_admin" "$password_dev" "$kek" "$audit_key" <<'PY'
import shlex, sys
path, database, admin, dev, kek, audit = sys.argv[1:]
connection = (
    f"Host=127.0.0.1;Port=5432;Database={database};Username=eclipsvault;"
    "Password=dev-postgres-password"
)
values = {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "https://localhost:7443;http://localhost:5080",
    "Database__Provider": "Postgres",
    "ConnectionStrings__DefaultConnection": connection,
    "Seed__AdminPassword": admin,
    "Seed__DevPassword": dev,
    "ECLIPSVAULT_KEK": kek,
    "ECLIPSVAULT_AUDIT_SIGNING_KEY": audit,
}
with open(path, "w") as env:
    for key, value in values.items():
        env.write(f"{key}={shlex.quote(value)}\n")
PY
  unset password_admin password_dev kek audit_key
  chmod 600 "$env_file"
  python3 -c 'import json,sys; json.dump({"pid": None, "database": sys.argv[1], "baseUrl": sys.argv[2], "dll": sys.argv[3]}, open(sys.argv[4], "w"))' \
    "$database" "$base_url" "$dll" "$state"

  if ! dotnet dev-certs https --check >/dev/null 2>&1; then
    dotnet dev-certs https >/dev/null
  fi

  dotnet build "$root/EclipsVault.slnx" -c Release >"$instance/build.log" 2>&1 \
    || { tail -n 40 "$instance/build.log" >&2; die "dotnet build failed. See logs/verify/instance/build.log."; }
  if [[ ! -d "$root/EclipsVault.AngularUi/node_modules/playwright" ]]; then
    (cd "$root/EclipsVault.AngularUi" && npm ci --ignore-scripts) >>"$instance/build.log" 2>&1 \
      || { tail -n 40 "$instance/build.log" >&2; die "npm ci failed. See logs/verify/instance/build.log."; }
  fi
  (cd "$root/EclipsVault.AngularUi" && npm run build) >>"$instance/build.log" 2>&1 \
    || { tail -n 40 "$instance/build.log" >&2; die "npm run build failed. See logs/verify/instance/build.log."; }
  [[ -f "$root/EclipsVault.Web/AngularUi/index.html" ]] \
    || die "The Angular UI build did not write EclipsVault.Web/AngularUi/index.html."

  (
    cd "$root/EclipsVault.Web"
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
    exec dotnet "$dll"
  ) >"$instance/vault.log" 2>&1 &
  local vault_pid=$!
  python3 -c 'import json,sys; p=sys.argv[1]; d=json.load(open(p)); d["pid"]=int(sys.argv[2]); json.dump(d, open(p,"w"))' \
    "$state" "$vault_pid"

  local deadline=$((SECONDS + 180))
  while (( SECONDS < deadline )); do
    if ! our_process "$vault_pid"; then
      tail -n 40 "$instance/vault.log" >&2 || true
      die "The vault exited before sign-in was ready. See logs/verify/instance/vault.log."
    fi
    local code
    code="$(curl -sk -o "$instance/login.body" -w '%{http_code}' "$base_url/Account/Login" || true)"
    if [[ "$code" == "200" ]] && grep -q 'Sign in' "$instance/login.body"; then
      rm -f "$instance/login.body"
      printf 'launched %s pid %s database %s\n' "$base_url" "$vault_pid" "$database"
      return
    fi
    sleep 2
  done
  tail -n 40 "$instance/vault.log" >&2 || true
  die "Sign-in did not answer within 180 seconds. See logs/verify/instance/vault.log."
}

doctor() {
  require_instance
  local pid database listener users
  pid="$(pid_from_state)"
  database="$(database_name)"
  [[ "$database" =~ ^evverify[0-9a-f]{8}$ ]] || die "State names a database this skill did not create."
  our_process "$pid" || die "Vault pid $pid is not the EclipsVault.Web.dll this run started."
  listener="$(listening_pid 7443 || true)"
  [[ "$listener" == "$pid" ]] || die "Port 7443 is owned by pid ${listener:-nobody}, not the verification vault pid $pid."
  local code
  code="$(curl -sk -o "$instance/login.body" -w '%{http_code}' --max-time 10 "$base_url/Account/Login" || true)"
  [[ "$code" == "200" ]] && grep -q 'Sign in' "$instance/login.body" \
    || die "https://localhost:7443/Account/Login did not serve the sign-in page (HTTP ${code:-none})."
  rm -f "$instance/login.body"
  [[ -f "$root/EclipsVault.Web/AngularUi/index.html" ]] \
    || die "Angular UI document is missing, so /SignIns cannot be served."
  users="$(psql "$database" -tA -c 'SELECT COUNT(*) FROM "Users"')"
  [[ "$users" -ge 2 ]] || die "The disposable database has $users accounts. Seed has not finished."
  printf 'ok vault\nbase %s\npid %s\ndatabase %s\naccounts %s\nlogin Sign in\n' \
    "$base_url" "$pid" "$database" "$users"
}

stop_pid() {
  local pid="$1"
  local check="$2"
  "$check" "$pid" || return 0
  kill "$pid" 2>/dev/null || true
  local n=0
  while "$check" "$pid" && (( n < 20 )); do
    sleep 0.25
    n=$((n + 1))
  done
  if "$check" "$pid"; then
    kill -9 "$pid" 2>/dev/null || true
  fi
}

cleanup() {
  if [[ ! -f "$state" ]]; then
    printf 'nothing to clean\n'
    return
  fi
  local pid database browser_pid
  browser_pid=""
  [[ -f "$instance/browser.pid" ]] && browser_pid="$(cat "$instance/browser.pid")"
  stop_pid "$browser_pid" browser_process
  pid="$(pid_from_state || true)"
  database="$(database_name || true)"
  stop_pid "$pid" our_process
  if [[ "$database" =~ ^evverify[0-9a-f]{8}$ ]]; then
    psql EclipsVaultUmbraDb -c \
      "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$database' AND pid <> pg_backend_pid();" \
      >/dev/null || true
    psql EclipsVaultUmbraDb -c "DROP DATABASE IF EXISTS \"$database\"" >/dev/null || true
  fi
  rm -rf "$instance"
  printf 'cleaned instance; evidence remains in logs/verify/evidence\n'
}

drive() {
  require_instance
  VERIFY_ROOT="$root" node "$root/.cursor/skills/verify-eclipsvault/browser.mjs" "$@"
}

usage() {
  cat <<'EOF'
usage: verify-eclipsvault launch
       verify-eclipsvault doctor
       verify-eclipsvault sign-in
       verify-eclipsvault browser goto <path>
       verify-eclipsvault browser click --role <role> --name <name> [--exact] [--row <text>]
       verify-eclipsvault browser click --text <text> [--exact]
       verify-eclipsvault browser fill --role <role> --name <name> --value <text> [--exact]
       verify-eclipsvault browser press --key <key>
       verify-eclipsvault browser expect --role <role> --name <name> [--exact]
       verify-eclipsvault browser expect --text <text>
       verify-eclipsvault browser screenshot --path <file>
       verify-eclipsvault browser snapshot --path <file>
       verify-eclipsvault cleanup
EOF
}

command="${1:-}"
shift || true
case "$command" in
  launch) launch ;;
  doctor) doctor ;;
  sign-in) drive sign-in ;;
  browser) drive browser "$@" ;;
  cleanup) cleanup ;;
  *) usage >&2; exit 2 ;;
esac
